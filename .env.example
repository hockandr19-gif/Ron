# Copy this to .env and fill in your values
# Never commit .env to git

# Coinbase Advanced Trade API credentials
# Get these at: https://www.coinbase.com/settings/api
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here

# Trading mode: "paper" (safe default) or "live" (real money)
TRADING_MODE=paper

# Risk settings
MAX_POSITION_USD=100       # Max dollars per trade
MAX_DAILY_LOSS_USD=50      # Stop trading for the day if loss exceeds this
RISK_PER_TRADE_PCT=0.02    # Risk 2% of portfolio per trade

# Default trading pairs (comma-separated)
SYMBOLS=BTC/USD,ETH/USD,SOL/USD

# Data cache location
DB_PATH=data/ron.db
